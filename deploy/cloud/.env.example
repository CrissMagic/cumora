# Copy to deploy/cloud/.env; never commit the filled file.
# Hostname only: no https://, slash, path, or port.
CUMORA_DOMAIN=cumora.example.com
CUMORA_IMAGE_TAG=local

# Generate EACH value separately with: openssl rand -hex 32
# Database password must be hex to remain URL-safe in DATABASE_URL.
POSTGRES_PASSWORD=
AGENT_RUNTIME_SECRET=

# Required by the current server; do not copy the LAN trial's placeholder.
OPENAI_API_KEY=

# GitHub OAuth callback: https://<CUMORA_DOMAIN>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The verified GitHub email of the initial administrator.
CUMORA_ADMIN_EMAILS=

# Optional: server model selection. Defaults follow server/src/env.ts.
# OPENAI_MODEL=
# OPENAI_MODEL_SUPPORT=
